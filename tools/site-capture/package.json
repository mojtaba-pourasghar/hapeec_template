{
  "name": "site-capture",
  "version": "1.0.0",
  "private": true,
  "description": "Crawl a website and save full-page desktop and mobile screenshots of every page type.",
  "type": "module",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "dev": "concurrently -k -n server,ui -c blue,green \"node server/index.js\" \"vite\"",
    "start": "vite build && node server/index.js --serve-ui",
    "capture": "node cli.js",
    "build": "vite build"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
